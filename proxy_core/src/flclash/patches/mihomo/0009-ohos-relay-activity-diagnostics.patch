 	manager *Manager
 
 	pushToManager bool `json:"-"`
+
+	activityEnabled       bool `json:"-"`
+	activityMu            sync.Mutex
+	activityUploadSeq     uint64
+	activityDownloadSeq   uint64
+	activityUploadTotal   int64
+	activityDownloadTotal int64
+	activityLastUpload    time.Time
+	activityLastDownload  time.Time
+	activityCloseLogged   bool
 }
 
+func (tt *tcpTracker) recordActivity(direction string, byteCount int64) {
+	if !tt.activityEnabled || byteCount <= 0 {
+		return
+	}
+	now := time.Now()
+	tt.activityMu.Lock()
+	var seq uint64
+	var total int64
+	var previous time.Time
+	if direction == "app-to-remote" {
+		tt.activityUploadSeq++
+		tt.activityUploadTotal += byteCount
+		seq = tt.activityUploadSeq
+		total = tt.activityUploadTotal
+		previous = tt.activityLastUpload
+		tt.activityLastUpload = now
+	} else {
+		tt.activityDownloadSeq++
+		tt.activityDownloadTotal += byteCount
+		seq = tt.activityDownloadSeq
+		total = tt.activityDownloadTotal
+		previous = tt.activityLastDownload
+		tt.activityLastDownload = now
+	}
+	tt.activityMu.Unlock()
+
+	idle := now.Sub(tt.Start)
+	if !previous.IsZero() {
+		idle = now.Sub(previous)
+	}
+	// The first successful transfer in each direction is always logged. Later
+	// transfers are logged only after an observable idle gap, keeping this
+	// diagnostic useful without flooding the device log or recording payloads.
+	if seq == 1 || idle >= time.Second {
+		log.Debugln("[TCP-FLOW] target=%s direction=%s seq=%d bytes=%d total=%d idle=%s age=%s",
+			tt.Metadata.RemoteAddress(), direction, seq, byteCount, total, idle, now.Sub(tt.Start))
+	}
+}
