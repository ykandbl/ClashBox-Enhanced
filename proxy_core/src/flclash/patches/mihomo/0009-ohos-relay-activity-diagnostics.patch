 func (tt *tcpTracker) Close() error {
+	if tt.activityEnabled {
+		tt.activityMu.Lock()
+		if !tt.activityCloseLogged {
+			tt.activityCloseLogged = true
+			log.Debugln("[TCP-FLOW] target=%s event=closed upload=%d download=%d age=%s",
+				tt.Metadata.RemoteAddress(), tt.activityUploadTotal, tt.activityDownloadTotal, time.Since(tt.Start))
+		}
+		tt.activityMu.Unlock()
+	}
 	tt.manager.Leave(tt)
 	return tt.Conn.Close()
 }
