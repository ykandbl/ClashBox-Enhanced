+	startedAt time.Time
+	mu        sync.Mutex
+	lastRead  time.Time
+	readCount uint64
+	totalRead uint64
+}
+
+func (c *tcpActivityConn) Read(buffer []byte) (int, error) {
+	readStartedAt := time.Now()
+	n, err := c.Conn.Read(buffer)
+	readFinishedAt := time.Now()
+	c.mu.Lock()
+	previousReadAt := c.lastRead
+	c.lastRead = readFinishedAt
+	c.readCount++
+	readCount := c.readCount
+	if n > 0 {
+		c.totalRead += uint64(n)
+	}
+	totalRead := c.totalRead
+	c.mu.Unlock()
+	gap := readStartedAt.Sub(c.startedAt)
+	if !previousReadAt.IsZero() {
+		gap = readStartedAt.Sub(previousReadAt)
+	}
+	// This is Debug-only and limited to OpenAI traffic. It records byte counts
+	// and timing only, never payload contents. Logging every read is deliberate:
+	// it lets a real-device trace distinguish an application that never writes
+	// its request from an outbound stream that never returns the response.
+	errText := ""
+	if err != nil {
+		errText = err.Error()
+	}
+	log.Debugln("[TCP-ACTIVITY] target=%s direction=%s seq=%d bytes=%d total=%d wait=%s idle=%s age=%s err=%q",
+		c.target, c.direction, readCount, n, totalRead, readFinishedAt.Sub(readStartedAt), gap,
+		readFinishedAt.Sub(c.startedAt), errText)
+	return n, err
+}
+
+func handleSocket(inbound, outbound net.Conn, metadata *C.Metadata) {
+	target := metadata.RemoteAddress()
+	normalizedTarget := strings.ToLower(target)
+	if strings.Contains(normalizedTarget, "openai.com") || strings.Contains(normalizedTarget, "chatgpt.com") {
+		startedAt := time.Now()
+		inbound = &tcpActivityConn{
+			Conn: inbound, direction: "app-to-core", target: target, startedAt: startedAt,
+		}
+		outbound = &tcpActivityConn{
+			Conn: outbound, direction: "remote-to-core", target: target, startedAt: startedAt,
+		}
+	}
 	N.Relay(inbound, outbound)
 }
